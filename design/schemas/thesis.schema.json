{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zen-tradings/zen-fundamentals/main/design/schemas/thesis.schema.json",
  "title": "Thesis",
  "description": "A long-lived, declarative view the agent maintains about one subject (RFC-004). Every PUT creates a new spec_revision. The fields under 'state' are system-managed and read-only.",
  "type": "object",
  "required": ["id", "template", "subject", "sources", "policy"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$",
      "description": "Owner-chosen slug, unique per tenant."
    },
    "template": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "enum": ["neocloud_deal"], "description": "Only neocloud_deal ships (RFC-008)." },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "subject": { "$ref": "#/$defs/NeocloudDealSubject" },
    "tracked_quantities": {
      "type": "object",
      "description": "Per-quantity enablement. Defaults to every template quantity enabled. Required template quantities cannot be disabled; quantities cannot be added.",
      "propertyNames": { "enum": ["acquirer_distribution", "p_acquired", "stake_probabilities", "expected_announcement_date", "relationships", "signals", "target_facts"] },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "enabled": { "type": "boolean" } }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "description": "Adapter configs, in priority order.",
      "items": { "$ref": "#/$defs/Source" }
    },
    "policy": { "$ref": "#/$defs/Policy" },
    "delivery": {
      "type": "object",
      "description": "Optional. A single webhook fired on version approval via the idempotent outbox (RFC-003).",
      "additionalProperties": false,
      "properties": {
        "webhook": {
          "type": "object",
          "required": ["url"],
          "additionalProperties": false,
          "properties": {
            "url": { "type": "string", "format": "uri" },
            "secret_ref": { "type": "string", "description": "Name of the secret used to sign payloads; never the secret itself." },
            "on": {
              "type": "array",
              "items": { "enum": ["version_approved", "thesis_resolved"] },
              "default": ["version_approved"]
            }
          }
        }
      }
    },
    "state": {
      "type": "object",
      "readOnly": true,
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["active", "paused", "resolved", "archived"] },
        "watching": { "type": "boolean" },
        "spec_revision": { "type": "integer", "minimum": 1 },
        "head_version_id": { "type": ["string", "null"], "description": "Latest approved ThesisVersion." },
        "pending_version_id": { "type": ["string", "null"], "description": "Candidate in needs_review, if any." },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    }
  },
  "$defs": {
    "CandidateKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,31}$",
      "not": { "enum": ["other", "none"] },
      "description": "Slug used in quantity keys. 'other' and 'none' are reserved."
    },
    "Target": {
      "type": "object",
      "required": ["name", "listing"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "listing": { "enum": ["private", "ipo_filed", "public"], "description": "At thesis creation; tracked afterwards in target_facts." },
        "cik": { "type": "string", "pattern": "^[0-9]{10}$", "description": "If an SEC registrant or Form D filer." },
        "ticker": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "listing": { "const": "public" } } },
          "then": { "required": ["ticker"] }
        }
      ]
    },
    "Candidate": {
      "type": "object",
      "required": ["key", "name", "type"],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "#/$defs/CandidateKey" },
        "name": { "type": "string" },
        "type": { "enum": ["ai_lab", "hyperscaler", "chipmaker", "neocloud", "other"] },
        "cik": { "type": "string", "pattern": "^[0-9]{10}$" },
        "ticker": { "type": "string" }
      }
    },
    "NeocloudDealSubject": {
      "type": "object",
      "required": ["target", "candidates", "horizon"],
      "additionalProperties": false,
      "properties": {
        "target": { "$ref": "#/$defs/Target" },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "description": "Named candidate acquirers and investors. Keys must be unique (enforced at validation; not expressible here). Any other party is 'other'.",
          "items": { "$ref": "#/$defs/Candidate" }
        },
        "horizon": {
          "type": "object",
          "required": ["start", "end"],
          "additionalProperties": false,
          "description": "Fixed; cannot be changed after creation. end defaults to start + 12 months, max 24 months (enforced at validation).",
          "properties": {
            "start": { "type": "string", "format": "date-time" },
            "end": { "type": "string", "format": "date" }
          }
        }
      }
    },
    "Source": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["edgar", "press_release", "news", "web_search"] },
        "tier": { "enum": ["primary", "secondary"], "description": "Defaults: edgar, press_release = primary; news, web_search = secondary. news and web_search cannot be raised to primary." }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "edgar" } } },
          "then": {
            "required": ["forms"],
            "properties": {
              "ciks": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]{10}$" }, "description": "Target CIK(s); all filings in 'forms' are routed." },
              "candidate_ciks": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]{10}$" }, "description": "Candidate filings are routed only if they mention the target (RFC-005 step 2)." },
              "candidate_tickers": { "type": "array", "items": { "type": "string" }, "description": "Resolved to CIKs at ingest; same routing rule as candidate_ciks." },
              "forms": { "type": "array", "minItems": 1, "items": { "type": "string" } }
            },
            "anyOf": [
              { "required": ["ciks"] },
              { "required": ["candidate_ciks"] },
              { "required": ["candidate_tickers"] }
            ]
          }
        },
        {
          "if": { "properties": { "type": { "const": "press_release" } } },
          "then": {
            "required": ["issuers"],
            "properties": {
              "issuers": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Target and candidate keys, or CIKs." },
              "feeds": { "type": "array", "items": { "type": "string", "format": "uri" } }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "news" } } },
          "then": {
            "required": ["outlets"],
            "properties": {
              "outlets": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Configured outlet IDs; each outlet carries a reliability (high | normal) in adapter config." },
              "tier": { "const": "secondary" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "web_search" } } },
          "then": {
            "required": ["queries"],
            "properties": {
              "queries": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "tier": { "const": "secondary" }
            }
          }
        }
      ]
    },
    "LogOddsRule": {
      "type": "object",
      "additionalProperties": false,
      "description": "Material if |logit(new) - logit(head)| >= logit_abs AND |new - head| >= prob_abs_min (RFC-005).",
      "properties": {
        "logit_abs": { "type": "number", "exclusiveMinimum": 0 },
        "prob_abs_min": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "Policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "material_change": {
          "type": "object",
          "description": "Overrides of template defaults (RFC-008). Omitted quantities use template defaults.",
          "additionalProperties": false,
          "properties": {
            "acquirer_distribution": {
              "type": "object",
              "additionalProperties": false,
              "description": "LogOddsRule applied per key (including other and none), plus an optional top-rank rule.",
              "properties": {
                "logit_abs": { "$ref": "#/$defs/LogOddsRule/properties/logit_abs" },
                "prob_abs_min": { "$ref": "#/$defs/LogOddsRule/properties/prob_abs_min" },
                "on_top_rank_change": { "type": "boolean" }
              }
            },
            "p_acquired": { "$ref": "#/$defs/LogOddsRule" },
            "stake_probabilities": { "$ref": "#/$defs/LogOddsRule" },
            "expected_announcement_date": {
              "type": "object",
              "additionalProperties": false,
              "properties": { "days": { "type": "integer", "minimum": 1 } }
            },
            "relationships": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "on": { "type": "array", "minItems": 1, "items": { "enum": ["added", "removed", "status_changed", "value_changed", "structure_changed"] } }
              }
            },
            "signals": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "on": { "type": "array", "minItems": 1, "items": { "enum": ["added", "status_changed"] } }
              }
            },
            "target_facts": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "on": { "type": "array", "minItems": 1, "items": { "enum": ["listing", "control", "capital", "capacity", "customer_concentration"] } }
              }
            }
          }
        },
        "prior_gap_flag": { "type": "number", "exclusiveMinimum": 1, "description": "Odds ratio between agent and reference prior on p_acquired above which an investor judgment item is raised (RFC-008)." },
        "stake_min_pct": { "type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 0.05 },
        "stake_min_usd": { "type": "number", "exclusiveMinimum": 0, "default": 1000000000 },
        "reestimate_days": { "type": "integer", "minimum": 1, "default": 30 },
        "budget_usd_per_evaluation": { "type": "number", "exclusiveMinimum": 0 },
        "max_latency_s": { "type": "integer", "minimum": 1 },
        "min_primary_sources": { "type": "integer", "minimum": 0, "default": 1 },
        "debounce_s": { "type": "integer", "minimum": 0, "default": 900 },
        "review": {
          "enum": ["required", "auto"],
          "default": "required",
          "description": "auto is accepted only in replay evaluation (RFC-007). Live theses reject it."
        },
        "routing": {
          "type": "object",
          "description": "Per-role overrides within template constraints (RFC-008). Constraints such as provider_must_differ_from cannot be removed.",
          "propertyNames": { "enum": ["planner", "estimator", "extractor", "auditor"] },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "tier": { "enum": ["strongest", "low_cost"] },
              "provider": { "type": "string" },
              "model_id": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
