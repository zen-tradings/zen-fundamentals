{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zen-tradings/zen-fundamentals/main/design/schemas/thesis.schema.json",
  "title": "Thesis",
  "description": "A long-lived, declarative view the agent maintains about one subject (RFC-004). Every PUT creates a new spec_revision. The fields under 'state' are system-managed and read-only.",
  "type": "object",
  "required": ["id", "template", "subject", "sources", "policy"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$",
      "description": "Owner-chosen slug, unique per tenant."
    },
    "template": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "enum": ["merger_arb"], "description": "Only merger_arb ships (RFC-008)." },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "subject": { "$ref": "#/$defs/MergerArbSubject" },
    "tracked_quantities": {
      "type": "object",
      "description": "Per-quantity enablement. Defaults to every template quantity enabled. Required template quantities cannot be disabled; quantities cannot be added.",
      "propertyNames": { "enum": ["scenarios", "close_probability", "expected_close_date", "conditions", "key_terms"] },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "enabled": { "type": "boolean" } }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "description": "Adapter configs, in priority order.",
      "items": { "$ref": "#/$defs/Source" }
    },
    "policy": { "$ref": "#/$defs/Policy" },
    "delivery": {
      "type": "object",
      "description": "Optional. A single webhook fired on version approval via the idempotent outbox (RFC-003).",
      "additionalProperties": false,
      "properties": {
        "webhook": {
          "type": "object",
          "required": ["url"],
          "additionalProperties": false,
          "properties": {
            "url": { "type": "string", "format": "uri" },
            "secret_ref": { "type": "string", "description": "Name of the secret used to sign payloads; never the secret itself." },
            "on": {
              "type": "array",
              "items": { "enum": ["version_approved", "thesis_resolved"] },
              "default": ["version_approved"]
            }
          }
        }
      }
    },
    "state": {
      "type": "object",
      "readOnly": true,
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["active", "paused", "resolved", "archived"] },
        "watching": { "type": "boolean" },
        "spec_revision": { "type": "integer", "minimum": 1 },
        "head_version_id": { "type": ["string", "null"], "description": "Latest approved ThesisVersion." },
        "pending_version_id": { "type": ["string", "null"], "description": "Candidate in needs_review, if any." },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    }
  },
  "$defs": {
    "Party": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "cik": { "type": "string", "pattern": "^[0-9]{10}$" },
        "ticker": { "type": "string" }
      }
    },
    "MergerArbSubject": {
      "type": "object",
      "required": ["target", "acquirers", "announcement"],
      "additionalProperties": false,
      "properties": {
        "target": {
          "allOf": [{ "$ref": "#/$defs/Party" }],
          "required": ["cik", "ticker"],
          "description": "US-listed SEC registrant."
        },
        "acquirers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/Party" }
        },
        "announcement": {
          "type": "object",
          "required": ["as_of"],
          "additionalProperties": false,
          "properties": {
            "as_of": { "type": "string", "format": "date-time" },
            "accession": { "type": "string", "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$" }
          }
        },
        "structure": { "enum": ["merger", "tender_offer", "two_step"] }
      }
    },
    "Source": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["edgar", "press_release", "web_search", "market_data"] },
        "tier": { "enum": ["primary", "secondary"], "description": "Defaults: edgar, press_release, market_data = primary; web_search = secondary. web_search cannot be raised to primary." }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "edgar" } } },
          "then": {
            "required": ["ciks", "forms"],
            "properties": {
              "ciks": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[0-9]{10}$" } },
              "forms": { "type": "array", "minItems": 1, "items": { "type": "string" } }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "press_release" } } },
          "then": {
            "required": ["issuers"],
            "properties": {
              "issuers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "feeds": { "type": "array", "items": { "type": "string", "format": "uri" } }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "web_search" } } },
          "then": {
            "required": ["queries"],
            "properties": {
              "queries": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "tier": { "const": "secondary" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "market_data" } } },
          "then": {
            "required": ["tickers"],
            "properties": {
              "tickers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "market_proxy": { "type": "string", "description": "Ticker used as M_t in the market-implied formula (RFC-008)." }
            }
          }
        }
      ]
    },
    "Policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "material_change": {
          "type": "object",
          "description": "Overrides of template defaults (RFC-008). Omitted quantities use template defaults.",
          "additionalProperties": false,
          "properties": {
            "scenarios": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "prob_abs": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
                "price_rel": { "type": "number", "exclusiveMinimum": 0 }
              }
            },
            "close_probability": {
              "type": "object",
              "additionalProperties": false,
              "properties": { "abs": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 } }
            },
            "expected_close_date": {
              "type": "object",
              "additionalProperties": false,
              "properties": { "days": { "type": "integer", "minimum": 1 } }
            },
            "conditions": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "on": { "type": "array", "items": { "enum": ["added", "removed", "status_changed"] }, "minItems": 1 }
              }
            },
            "key_terms": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "on": {
                  "oneOf": [
                    { "const": "any" },
                    { "type": "array", "minItems": 1, "items": { "enum": ["consideration", "price_per_share", "break_fee", "outside_date"] } }
                  ]
                }
              }
            }
          }
        },
        "market_gap_flag": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "budget_usd_per_evaluation": { "type": "number", "exclusiveMinimum": 0 },
        "max_latency_s": { "type": "integer", "minimum": 1 },
        "min_primary_sources": { "type": "integer", "minimum": 0, "default": 1 },
        "debounce_s": { "type": "integer", "minimum": 0, "default": 900 },
        "review": {
          "enum": ["required", "auto"],
          "default": "required",
          "description": "auto is accepted only in replay evaluation (RFC-007). Live theses reject it."
        },
        "routing": {
          "type": "object",
          "description": "Per-role overrides within template constraints (RFC-008). Constraints such as provider_must_differ_from cannot be removed.",
          "propertyNames": { "enum": ["planner", "estimator", "extractor", "auditor"] },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "tier": { "enum": ["strongest", "low_cost"] },
              "provider": { "type": "string" },
              "model_id": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
