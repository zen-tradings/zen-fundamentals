{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zen-tradings/zen-fundamentals/main/design/schemas/thesis-version.schema.json",
  "title": "ThesisVersion",
  "description": "An immutable snapshot of every tracked quantity at a clock, with provenance (RFC-004). Everything except review_state is covered by content_hash. review_state is derived from the append-only review_events log.",
  "type": "object",
  "required": ["id", "thesis_id", "seq", "parent_version_id", "spec_revision", "template", "clock", "trigger", "evidence_set", "values", "deltas", "carried_forward", "self_check", "recoveries", "review_packet_id", "routing", "cost", "latency_ms", "created_at", "content_hash"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^tv_[a-z0-9]{16,64}$" },
    "thesis_id": { "type": "string" },
    "seq": { "type": "integer", "minimum": 1, "description": "Monotonic per thesis; allocated inside the fenced commit transaction (RFC-003)." },
    "parent_version_id": {
      "type": ["string", "null"],
      "description": "Approved head this version was diffed against. Null for the initial version."
    },
    "supersedes": {
      "type": ["string", "null"],
      "description": "Pending candidate this version superseded, if any (RFC-004)."
    },
    "spec_revision": { "type": "integer", "minimum": 1 },
    "template": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "clock": {
      "type": "string",
      "format": "date-time",
      "description": "Point-in-time bound. No evidence with as_of > clock influenced this version."
    },
    "trigger": {
      "type": "object",
      "required": ["kind", "evidence_ids"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["initial", "evidence", "heartbeat", "manual", "spec_revision", "resolution"] },
        "evidence_ids": { "type": "array", "items": { "$ref": "#/$defs/EvidenceId" }, "description": "Empty for heartbeat." }
      }
    },
    "evidence_set": {
      "type": "object",
      "required": ["ids", "hash", "max_as_of"],
      "additionalProperties": false,
      "properties": {
        "ids": { "type": "array", "items": { "$ref": "#/$defs/EvidenceId" }, "uniqueItems": true },
        "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "description": "Hash of the sorted ids; part of the idempotency key (RFC-005)." },
        "max_as_of": { "type": "string", "format": "date-time", "description": "Must be <= clock." }
      }
    },
    "values": {
      "$ref": "#/$defs/NeocloudDealValues"
    },
    "deltas": {
      "type": "array",
      "items": { "$ref": "#/$defs/Delta" }
    },
    "carried_forward": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true,
      "description": "Quantities not re-estimated in this evaluation; values copied from the parent."
    },
    "reference_prior": { "$ref": "#/$defs/ReferencePrior" },
    "self_check": { "$ref": "#/$defs/SelfCheck" },
    "recoveries": {
      "type": "array",
      "items": { "$ref": "#/$defs/RecoveryEvent" }
    },
    "review_packet_id": { "type": "string", "pattern": "^rp_[a-z0-9]{16,64}$" },
    "routing": {
      "type": "object",
      "required": ["planner", "estimator", "extractor", "auditor"],
      "additionalProperties": false,
      "properties": {
        "planner": { "$ref": "#/$defs/ModelRef" },
        "estimator": { "$ref": "#/$defs/ModelRef" },
        "extractor": { "$ref": "#/$defs/ModelRef" },
        "auditor": {
          "anyOf": [{ "$ref": "#/$defs/ModelRef" }, { "type": "null" }],
          "description": "Null only in the no-auditor ablation (RFC-007 A2)."
        },
        "provider_is_candidate": {
          "type": "array",
          "items": { "enum": ["planner", "estimator", "extractor", "auditor"] },
          "uniqueItems": true,
          "description": "Roles whose provider is also a named candidate in the thesis (RFC-008 Conflict of interest). Flag only; never blocks the route."
        }
      }
    },
    "cost": {
      "type": "object",
      "required": ["usd"],
      "additionalProperties": false,
      "properties": {
        "usd": { "type": "number", "minimum": 0 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "reasoning_tokens": { "type": "integer", "minimum": 0 }
      }
    },
    "latency_ms": { "type": "integer", "minimum": 0 },
    "created_at": { "type": "string", "format": "date-time" },
    "content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "review_state": {
      "readOnly": true,
      "enum": ["needs_review", "approved", "rejected", "superseded"],
      "description": "Not part of content_hash. Derived from review_events."
    }
  },
  "$defs": {
    "EvidenceId": { "type": "string", "pattern": "^ev_[a-z0-9]{16,64}$" },
    "ModelRef": {
      "type": "object",
      "required": ["provider", "model_id", "role"],
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string" },
        "model_id": { "type": "string" },
        "role": { "enum": ["planner", "estimator", "extractor", "auditor", "eval_judge"] },
        "route": { "enum": ["primary", "alternate"], "default": "primary" }
      }
    },
    "Probability": { "type": "number", "minimum": 0, "maximum": 1 },
    "Money": {
      "type": "object",
      "required": ["amount", "currency"],
      "additionalProperties": false,
      "properties": {
        "amount": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    },
    "CandidateKey": { "$ref": "thesis.schema.json#/$defs/CandidateKey" },
    "OutcomeKey": {
      "description": "A candidate key, or one of the reserved keys other and none.",
      "anyOf": [
        { "$ref": "#/$defs/CandidateKey" },
        { "enum": ["other", "none"] }
      ]
    },
    "DistributionEntry": {
      "type": "object",
      "required": ["key", "probability"],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "#/$defs/OutcomeKey" },
        "probability": { "$ref": "#/$defs/Probability" },
        "rationale": { "type": "string" }
      }
    },
    "CandidateDistribution": {
      "type": "array",
      "description": "Exactly one entry per candidate key, plus other and none. Probabilities must sum to 1 within 1e-6, and every candidate must appear exactly once. Those rules can't be expressed in JSON Schema, so they are enforced by the self-check (RFC-005).",
      "minItems": 3,
      "maxItems": 14,
      "items": { "$ref": "#/$defs/DistributionEntry" },
      "allOf": [
        { "contains": { "properties": { "key": { "const": "other" } } } },
        { "contains": { "properties": { "key": { "const": "none" } } } }
      ]
    },
    "DerivedProbability": {
      "type": "object",
      "required": ["value", "derived_from", "formula"],
      "additionalProperties": false,
      "properties": {
        "value": { "$ref": "#/$defs/Probability" },
        "derived_from": { "const": "acquirer_distribution" },
        "formula": { "const": "1 - P(none)" }
      }
    },
    "StakeEntry": {
      "type": "object",
      "required": ["key", "probability", "resolved"],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "#/$defs/CandidateKey" },
        "probability": { "$ref": "#/$defs/Probability" },
        "resolved": { "type": "boolean", "description": "True once the candidate's stake event has happened; probability is then 1 and computed by code." },
        "resolved_by": { "type": "array", "items": { "$ref": "#/$defs/EvidenceId" } },
        "structure": { "$ref": "#/$defs/StakeStructure" },
        "structure_flags": { "type": "array", "items": { "$ref": "#/$defs/StakeStructure" }, "uniqueItems": true },
        "rationale": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "resolved": { "const": true } } },
          "then": { "required": ["resolved_by", "structure"], "properties": { "probability": { "const": 1 } } }
        }
      ]
    },
    "ProbabilityMap": {
      "type": "array",
      "description": "One entry per candidate key. Independent probabilities; they do not sum to 1. Each must be >= that candidate's acquirer_distribution probability (self-check).",
      "minItems": 1,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/StakeEntry" }
    },
    "DateEstimate": {
      "type": "object",
      "required": ["date"],
      "additionalProperties": false,
      "properties": {
        "date": { "type": "string", "format": "date" },
        "interval_80": {
          "type": "object",
          "required": ["low", "high"],
          "additionalProperties": false,
          "properties": {
            "low": { "type": "string", "format": "date" },
            "high": { "type": "string", "format": "date" }
          }
        },
        "conditional_on": { "const": "acquisition_in_horizon" }
      }
    },
    "Relationship": {
      "type": "object",
      "required": ["key", "candidate", "type", "role", "status", "first_disclosed_as_of"],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^(compute_contract|gpu_supply|equity|debt|capacity_backstop|board|partnership|other:[a-z0-9_-]+):[a-z][a-z0-9_]{1,31}(:[a-z0-9_-]+)?$",
          "description": "Canonical key <type>:<candidate>[:<slug>] from the RFC-008 vocabulary, e.g. compute_contract:microsoft, equity:nvidia."
        },
        "candidate": { "$ref": "#/$defs/CandidateKey" },
        "type": { "enum": ["compute_contract", "gpu_supply", "equity", "debt", "capacity_backstop", "board", "partnership", "other"] },
        "role": { "enum": ["customer", "supplier", "investor", "lender", "partner", "other"] },
        "status": { "enum": ["announced", "active", "expired", "terminated"] },
        "value": { "$ref": "#/$defs/Money" },
        "term_years": { "type": "number", "exclusiveMinimum": 0 },
        "ownership_pct": { "type": "number", "minimum": 0, "maximum": 1 },
        "structure": { "$ref": "#/$defs/StakeStructure" },
        "structure_flags": { "type": "array", "items": { "$ref": "#/$defs/StakeStructure" }, "uniqueItems": true },
        "linked_relationships": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true,
          "description": "Relationship keys that justify a commercial structure tag (supply, backstop, or compute contract). Required non-empty for vendor_financing, capacity_backstop, customer_equity_kicker (self-check)."
        },
        "first_disclosed_as_of": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "enum": ["equity", "debt"] } } },
          "then": { "required": ["structure"] }
        }
      ]
    },
    "StakeStructure": {
      "enum": ["vendor_financing", "capacity_backstop", "customer_equity_kicker", "pure_equity", "arms_length", "undetermined"],
      "description": "RFC-008 structure tag. Describes the commercial context of equity or debt; never decides whether a stake event happened. arms_length is the debt counterpart of pure_equity."
    },
    "Signal": {
      "type": "object",
      "required": ["key", "description", "status", "direction", "basis"],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^(strategic_review|talks|talks_denied|concentration|financing|ipo|candidate|control|regulatory|leadership|other)(:[a-z0-9_-]+)*$",
          "description": "Canonical key from the RFC-008 vocabulary, e.g. strategic_review, talks:openai, ipo:filed."
        },
        "description": { "type": "string" },
        "status": { "enum": ["present", "resolved", "contradicted"] },
        "direction": { "enum": ["raises", "lowers", "ambiguous"] },
        "candidates": { "type": "array", "items": { "$ref": "#/$defs/CandidateKey" }, "uniqueItems": true },
        "basis": { "enum": ["primary", "secondary_only"] }
      }
    },
    "TargetFacts": {
      "type": "object",
      "required": ["listing"],
      "additionalProperties": false,
      "properties": {
        "listing": {
          "type": "object",
          "required": ["status"],
          "additionalProperties": false,
          "properties": {
            "status": { "enum": ["private", "ipo_filed", "public"] },
            "exchange": { "type": "string" },
            "ticker": { "type": "string" }
          }
        },
        "control": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "voting_control_holder": { "type": "string" },
            "dual_class": { "type": "boolean" },
            "change_of_control_provisions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["instrument", "description"],
                "additionalProperties": false,
                "properties": {
                  "instrument": { "type": "string", "description": "e.g. credit facility, customer contract" },
                  "description": { "type": "string" }
                }
              }
            }
          }
        },
        "capital": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "last_valuation": { "$ref": "#/$defs/Money" },
            "last_valuation_as_of": { "type": "string", "format": "date" },
            "total_debt": { "$ref": "#/$defs/Money" },
            "contracted_backlog": { "$ref": "#/$defs/Money" }
          }
        },
        "capacity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "power_mw": { "type": "number", "minimum": 0 },
            "accelerators": { "type": "integer", "minimum": 0 }
          }
        },
        "customer_concentration": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "top_customer": { "type": "string", "description": "Candidate key when the top customer is a candidate; otherwise a name or 'undisclosed'." },
            "top_customer_share": { "type": "number", "minimum": 0, "maximum": 1 },
            "basis": { "enum": ["revenue", "backlog"] }
          }
        }
      }
    },
    "NeocloudDealValues": {
      "type": "object",
      "required": ["acquirer_distribution", "p_acquired", "stake_probabilities", "expected_announcement_date", "relationships", "signals", "target_facts"],
      "additionalProperties": false,
      "properties": {
        "acquirer_distribution": { "$ref": "#/$defs/CandidateDistribution" },
        "p_acquired": { "$ref": "#/$defs/DerivedProbability" },
        "stake_probabilities": { "$ref": "#/$defs/ProbabilityMap" },
        "expected_announcement_date": { "$ref": "#/$defs/DateEstimate" },
        "relationships": { "type": "array", "items": { "$ref": "#/$defs/Relationship" } },
        "signals": { "type": "array", "items": { "$ref": "#/$defs/Signal" } },
        "target_facts": { "$ref": "#/$defs/TargetFacts" }
      }
    },
    "Delta": {
      "type": "object",
      "required": ["quantity", "changed", "material"],
      "additionalProperties": false,
      "properties": {
        "quantity": { "enum": ["acquirer_distribution", "p_acquired", "stake_probabilities", "expected_announcement_date", "relationships", "signals", "target_facts"] },
        "changed": { "type": "boolean" },
        "material": { "type": "boolean" },
        "rule": { "type": "string", "description": "Rule that fired, e.g. 'acquirer_distribution.logit_abs>=0.7 (openai)' or 'acquirer_distribution.top_rank_change'." },
        "detail": {
          "type": "object",
          "description": "Typed delta. probability: {abs, logit}; candidate_distribution: {per_key[{key, abs, logit}], top_rank{from, to}}; probability_map: {per_key[{key, abs, logit}], resolved[]}; date: {days}; relationships: {added[], removed[], status_changed[{key, from, to}], value_changed[], structure_changed[{key, from, to}]}; signals: {added[], status_changed[{key, from, to}]}; target_facts: {groups[]}."
        }
      }
    },
    "ReferencePrior": {
      "type": "object",
      "description": "RFC-008 reference prior. Reference only: not a tracked quantity, not an estimator input, never gates. Computed from shared extractions, never from the estimator's relationships quantity.",
      "required": ["formula_version", "weights_version", "acquirer", "p_acquired", "stakes", "inputs"],
      "additionalProperties": false,
      "properties": {
        "formula_version": { "const": "rp-1" },
        "weights_version": { "type": "string", "description": "Template minor version the weight table was fit for." },
        "acquirer": { "type": "array", "items": { "$ref": "#/$defs/DistributionEntry" } },
        "p_acquired": { "$ref": "#/$defs/Probability" },
        "stakes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "probability"],
            "additionalProperties": false,
            "properties": {
              "key": { "$ref": "#/$defs/CandidateKey" },
              "probability": { "$ref": "#/$defs/Probability" }
            }
          }
        },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "years_remaining": { "type": "number", "minimum": 0 },
            "b_listing": { "$ref": "#/$defs/Probability" },
            "strategic_review_applied": { "type": "boolean" },
            "w_other": { "type": "number", "minimum": 0 },
            "per_candidate": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["key", "w", "m"],
                "additionalProperties": false,
                "properties": {
                  "key": { "$ref": "#/$defs/CandidateKey" },
                  "w": { "type": "number", "minimum": 0 },
                  "m": { "type": "number", "minimum": 0 },
                  "b_stake": { "$ref": "#/$defs/Probability" },
                  "relationship_keys": { "type": "array", "items": { "type": "string" } }
                }
              }
            },
            "extraction_evidence_ids": { "type": "array", "items": { "$ref": "#/$defs/EvidenceId" } }
          }
        }
      }
    },
    "SelfCheck": {
      "type": "object",
      "required": ["passed", "revised", "checks"],
      "additionalProperties": false,
      "properties": {
        "passed": { "type": "boolean" },
        "revised": { "type": "boolean", "description": "True if the estimator used its one revision." },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "method", "passed"],
            "additionalProperties": false,
            "properties": {
              "name": {
                "enum": ["distribution_sum", "candidate_coverage", "derivation", "stake_ge_acquisition", "resolved_stakes", "date_in_horizon", "structure_links", "citation_coverage", "as_of_le_clock", "narrative_consistency"]
              },
              "method": { "enum": ["code", "model"] },
              "passed": { "type": "boolean" },
              "passed_after_revision": { "type": "boolean" },
              "detail": { "type": "string" }
            }
          }
        }
      }
    },
    "RecoveryEvent": {
      "type": "object",
      "required": ["step", "tool_or_route", "error_class", "attempts", "path", "outcome"],
      "additionalProperties": false,
      "properties": {
        "step": { "enum": ["ingest", "impact", "extract", "estimate", "self_check", "audit"] },
        "tool_or_route": { "type": "string" },
        "error_class": { "enum": ["fetch_5xx", "fetch_timeout", "rate_limited", "malformed_document", "extractor_malformed", "extractor_timeout", "route_outage", "other"] },
        "attempts": { "type": "integer", "minimum": 1 },
        "path": { "type": "string", "pattern": "^(retry|alternate:[A-Za-z0-9._-]+|degraded|failed)$" },
        "outcome": { "enum": ["recovered", "degraded", "failed"] },
        "latency_ms": { "type": "integer", "minimum": 0 },
        "injected": { "type": "boolean", "description": "Set by the RFC-007 fault-injection harness only." }
      }
    }
  }
}
