{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zen-tradings/zen-fundamentals/main/design/schemas/core/review-packet.schema.json",
  "title": "ReviewPacket",
  "description": "Immutable human-review artifact for one ThesisVersion (RFC-006). Template-agnostic: template-specific tables are sections whose kinds come from the core list and whose order comes from the template's packet_layout (RFC-009).",
  "type": "object",
  "required": ["id", "version_id", "thesis_id", "header", "changes", "unchanged", "conflicts", "uncertain_items", "investor_judgment_items", "self_check", "recoveries", "evidence_appendix", "audit_summary"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^rp_[a-z0-9]{16,64}$" },
    "version_id": { "type": "string", "pattern": "^tv_[a-z0-9]{16,64}$" },
    "thesis_id": { "type": "string" },
    "header": {
      "type": "object",
      "required": ["seq", "parent_version_id", "clock", "template", "spec_revision", "trigger", "routing", "audit_status"],
      "additionalProperties": false,
      "properties": {
        "seq": { "type": "integer", "minimum": 1 },
        "parent_version_id": { "type": ["string", "null"] },
        "clock": { "type": "string", "format": "date-time" },
        "template": { "$ref": "thesis-version.schema.json#/properties/template" },
        "spec_revision": { "type": "integer", "minimum": 1 },
        "trigger": { "$ref": "thesis-version.schema.json#/properties/trigger" },
        "routing": { "$ref": "thesis-version.schema.json#/properties/routing" },
        "audit_status": { "enum": ["passed", "failed", "overridden"] },
        "degradations": {
          "type": "array",
          "description": "Template degrade_order steps that budget pressure applied (RFC-005).",
          "items": { "type": "string" }
        }
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["quantity", "old_value", "new_value", "delta", "caused_by", "claims"],
        "additionalProperties": false,
        "properties": {
          "quantity": { "type": "string", "description": "Template quantity name." },
          "old_value": { "description": "Typed by the quantity's core type (quantity-types.schema.json); null for the initial version." },
          "new_value": { "description": "Typed by the quantity's core type (quantity-types.schema.json)." },
          "delta": { "$ref": "thesis-version.schema.json#/$defs/Delta" },
          "caused_by": {
            "type": "array",
            "description": "Evidence that triggered re-estimation of this quantity (from the ImpactAssessment).",
            "items": { "$ref": "thesis-version.schema.json#/$defs/EvidenceId" }
          },
          "claims": { "type": "array", "items": { "$ref": "#/$defs/Claim" } }
        }
      }
    },
    "sections": {
      "type": "array",
      "description": "Template-defined tables, in packet_layout order (RFC-009).",
      "items": { "$ref": "#/$defs/Section" }
    },
    "baseline_comparison": { "$ref": "#/$defs/BaselineComparison" },
    "unchanged": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["quantity", "reason"],
        "additionalProperties": false,
        "properties": {
          "quantity": { "type": "string" },
          "reason": { "enum": ["carried_forward", "reestimated_no_change"] }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "sides", "resolution"],
        "additionalProperties": false,
        "properties": {
          "description": { "type": "string" },
          "sides": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["claim_ids"],
              "additionalProperties": false,
              "properties": {
                "claim_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } }
              }
            }
          },
          "resolution": { "type": "string" },
          "resolved_by": { "$ref": "thesis-version.schema.json#/$defs/ModelRef" }
        }
      }
    },
    "uncertain_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["by", "reason"],
        "additionalProperties": false,
        "properties": {
          "claim_id": { "type": "string" },
          "quantity": { "type": "string" },
          "by": { "enum": ["estimator", "auditor", "self_check", "recovery", "audit_code"] },
          "reason": {
            "type": "string",
            "description": "Free text, or secondary_only for changes supported only by secondary evidence (templates that opt in, RFC-006)."
          }
        },
        "anyOf": [{ "required": ["claim_id"] }, { "required": ["quantity"] }]
      }
    },
    "investor_judgment_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question", "why", "related_quantities"],
        "additionalProperties": false,
        "properties": {
          "question": { "type": "string" },
          "why": { "type": "string", "description": "Why this is judgment rather than fact." },
          "related_quantities": { "type": "array", "items": { "type": "string" } },
          "considerations": { "type": "array", "items": { "type": "string" } },
          "source": { "enum": ["estimator", "template_prompt", "baseline_gap", "secondary_credibility"] }
        }
      }
    },
    "self_check": { "$ref": "thesis-version.schema.json#/$defs/SelfCheck" },
    "recoveries": {
      "type": "array",
      "items": { "$ref": "thesis-version.schema.json#/$defs/RecoveryEvent" }
    },
    "evidence_appendix": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidence_id", "source", "tier", "doc_type", "as_of", "content_hash"],
        "additionalProperties": false,
        "properties": {
          "evidence_id": { "$ref": "thesis-version.schema.json#/$defs/EvidenceId" },
          "source": { "$ref": "evidence-item.schema.json#/properties/source" },
          "tier": { "$ref": "evidence-item.schema.json#/properties/tier" },
          "doc_type": { "type": "string" },
          "as_of": { "type": "string", "format": "date-time" },
          "content_hash": { "$ref": "evidence-item.schema.json#/properties/content_hash" }
        }
      }
    },
    "audit_summary": {
      "type": "object",
      "required": ["checks", "repair_attempted", "spot_check_selected"],
      "additionalProperties": false,
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "by", "passed"],
            "additionalProperties": false,
            "properties": {
              "name": {
                "enum": ["evidence_in_set", "as_of_le_clock", "stated_dates", "quote_exists", "quote_supports", "provenance_label", "primary_citation_per_change", "secondary_only"]
              },
              "by": { "enum": ["code", "auditor"] },
              "passed": { "type": "boolean" },
              "failures": { "type": "array", "items": { "type": "string" }, "description": "Claim IDs or quantities that failed." }
            }
          }
        },
        "repair_attempted": { "type": "boolean" },
        "spot_check_selected": { "type": "boolean", "description": "Selected for human citation spot-check (RFC-007 §4)." },
        "override_reason": {
          "type": "string",
          "description": "Required when approving with audit_status failed; then audit_status reads overridden. The value replay_auto is reserved for replay auto-approval of rumor-only audit failures (RFC-004)."
        }
      }
    }
  },
  "$defs": {
    "Section": {
      "type": "object",
      "required": ["kind", "quantity", "rows"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["distribution_table", "map_table", "scenario_table", "list_changes", "date_change", "facts_changes"] },
        "quantity": { "type": "string" },
        "derived": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Derived quantities shown beneath the table as computed claims."
        },
        "rows": {
          "type": "array",
          "description": "Row shape by kind: distribution_table → DistributionRow, map_table → MapRow, scenario_table → ScenarioRow, list_changes → ListChangeRow, date_change / facts_changes → ValueChangeRow."
        },
        "parties_without_items": {
          "type": "array",
          "items": { "$ref": "quantity-types.schema.json#/$defs/Key" },
          "description": "list_changes only: subject parties with no item found, shown explicitly."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "distribution_table" } }
          },
          "then": {
            "properties": {
              "rows": { "items": { "$ref": "#/$defs/DistributionRow" } }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "map_table" } } },
          "then": {
            "properties": {
              "rows": { "items": { "$ref": "#/$defs/MapRow" } }
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "scenario_table" } }
          },
          "then": {
            "properties": {
              "rows": { "items": { "$ref": "#/$defs/ScenarioRow" } }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "list_changes" } } },
          "then": {
            "properties": {
              "rows": { "items": { "$ref": "#/$defs/ListChangeRow" } }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": { "enum": ["date_change", "facts_changes"] }
            }
          },
          "then": {
            "properties": {
              "rows": { "items": { "$ref": "#/$defs/ValueChangeRow" } }
            }
          }
        }
      ]
    },
    "DistributionRow": {
      "type": "object",
      "required": ["key", "new_probability", "new_rank"],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "quantity-types.schema.json#/$defs/Key" },
        "old_probability": {
          "anyOf": [
            { "$ref": "quantity-types.schema.json#/$defs/Probability" },
            { "type": "null" }
          ]
        },
        "new_probability": { "$ref": "quantity-types.schema.json#/$defs/Probability" },
        "delta_abs": { "type": ["number", "null"] },
        "delta_logit": { "type": ["number", "null"] },
        "baseline": {
          "anyOf": [
            { "$ref": "quantity-types.schema.json#/$defs/Probability" },
            { "type": "null" }
          ]
        },
        "claim_ids": { "type": "array", "items": { "type": "string" } },
        "old_rank": { "type": ["integer", "null"], "minimum": 1 },
        "new_rank": { "type": "integer", "minimum": 1 }
      }
    },
    "MapRow": {
      "type": "object",
      "required": ["key", "new_probability", "resolved"],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "quantity-types.schema.json#/$defs/Key" },
        "old_probability": {
          "anyOf": [
            { "$ref": "quantity-types.schema.json#/$defs/Probability" },
            { "type": "null" }
          ]
        },
        "new_probability": { "$ref": "quantity-types.schema.json#/$defs/Probability" },
        "delta_abs": { "type": ["number", "null"] },
        "delta_logit": { "type": ["number", "null"] },
        "baseline": {
          "anyOf": [
            { "$ref": "quantity-types.schema.json#/$defs/Probability" },
            { "type": "null" }
          ]
        },
        "claim_ids": { "type": "array", "items": { "type": "string" } },
        "resolved": { "type": "boolean" },
        "labels": { "$ref": "quantity-types.schema.json#/$defs/Labels" }
      }
    },
    "ScenarioRow": {
      "type": "object",
      "required": ["outcome", "new_probability"],
      "additionalProperties": false,
      "properties": {
        "outcome": { "$ref": "quantity-types.schema.json#/$defs/Key" },
        "old_probability": {
          "anyOf": [
            { "$ref": "quantity-types.schema.json#/$defs/Probability" },
            { "type": "null" }
          ]
        },
        "new_probability": { "$ref": "quantity-types.schema.json#/$defs/Probability" },
        "old_value": {
          "anyOf": [
            { "$ref": "quantity-types.schema.json#/$defs/Money" },
            { "type": "null" }
          ]
        },
        "new_value": {
          "anyOf": [
            { "$ref": "quantity-types.schema.json#/$defs/Money" },
            { "type": "null" }
          ]
        },
        "claim_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ListChangeRow": {
      "type": "object",
      "required": ["key", "change"],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "quantity-types.schema.json#/$defs/VocabKey" },
        "change": { "enum": ["added", "removed", "status_changed", "value_changed", "label_changed", "unchanged"] },
        "from": {},
        "to": {},
        "labels": { "$ref": "quantity-types.schema.json#/$defs/Labels" },
        "linked": {
          "type": "array",
          "items": { "$ref": "quantity-types.schema.json#/$defs/VocabKey" }
        },
        "secondary_only": { "type": "boolean" },
        "claim_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ValueChangeRow": {
      "type": "object",
      "required": ["field"],
      "additionalProperties": false,
      "properties": {
        "field": { "type": "string", "description": "Date field or facts group/field path." },
        "old": {},
        "new": {},
        "claim_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "BaselineComparison": {
      "type": "object",
      "required": ["baseline", "flagged"],
      "additionalProperties": false,
      "description": "The template's comparison baseline next to the agent's values (RFC-006). Context for the reviewer; not a claim, not audited.",
      "properties": {
        "baseline": { "$ref": "thesis-version.schema.json#/$defs/ComparisonBaseline" },
        "gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["quantity"],
            "additionalProperties": false,
            "properties": {
              "quantity": { "type": "string" },
              "key": { "$ref": "quantity-types.schema.json#/$defs/Key" },
              "agent": {},
              "baseline": {},
              "measure": { "enum": ["abs", "odds_ratio", "days", "top_rank"] },
              "gap": { "type": ["number", "string", "null"] }
            }
          }
        },
        "flagged": {
          "type": "boolean",
          "description": "True if a gap exceeds the template's gap_flag; an investor judgment item is then added."
        }
      }
    },
    "Claim": {
      "type": "object",
      "required": ["id", "text", "quantity", "provenance", "model", "citations", "audit", "uncertain"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^cl_[a-z0-9]{8,64}$" },
        "text": { "type": "string" },
        "quantity": { "type": "string" },
        "provenance": {
          "enum": ["extracted", "computed", "inferred"],
          "description": "extracted: the cited quote entails the claim with at most normalization. computed: deterministic code, no model. inferred: a model concluded beyond the text."
        },
        "model": {
          "anyOf": [
            { "$ref": "thesis-version.schema.json#/$defs/ModelRef" },
            { "type": "null" }
          ]
        },
        "computation": {
          "type": "object",
          "required": ["formula", "input_claim_ids"],
          "additionalProperties": false,
          "properties": {
            "formula": { "type": "string" },
            "input_claim_ids": { "type": "array", "items": { "type": "string" } }
          }
        },
        "citations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["evidence_id", "locator", "quote"],
            "additionalProperties": false,
            "properties": {
              "evidence_id": { "$ref": "thesis-version.schema.json#/$defs/EvidenceId" },
              "locator": {
                "type": "string",
                "description": "Section, page, or char span, e.g. 'S-1 Principal Stockholders' or 'chars:10230-10412'."
              },
              "quote": { "type": "string" }
            }
          }
        },
        "audit": {
          "type": "object",
          "required": ["citation", "provenance_ok", "as_of_ok"],
          "additionalProperties": false,
          "properties": {
            "citation": { "enum": ["supported", "partial", "unsupported", "not_checked"] },
            "provenance_ok": { "type": "boolean" },
            "as_of_ok": { "type": "boolean" },
            "auditor": {
              "anyOf": [
                { "$ref": "thesis-version.schema.json#/$defs/ModelRef" },
                { "type": "null" }
              ]
            },
            "downgraded_from": { "const": "extracted", "description": "Set when the auditor downgraded an extracted claim to inferred." }
          }
        },
        "uncertain": {
          "type": "object",
          "required": ["flagged"],
          "additionalProperties": false,
          "properties": {
            "flagged": { "type": "boolean" },
            "by": { "enum": ["estimator", "auditor", "self_check", "recovery", "audit_code"] },
            "reason": { "type": "string" }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "provenance": { "const": "computed" } }
          },
          "then": { "required": ["computation"], "properties": { "model": { "type": "null" } } },
          "else": {
            "properties": {
              "model": { "$ref": "thesis-version.schema.json#/$defs/ModelRef" }
            }
          }
        },
        {
          "if": {
            "properties": { "provenance": { "const": "extracted" } }
          },
          "then": { "properties": { "citations": { "minItems": 1 } } }
        }
      ]
    }
  }
}
