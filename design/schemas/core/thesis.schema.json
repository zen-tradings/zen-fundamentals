{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zen-tradings/zen-fundamentals/main/design/schemas/core/thesis.schema.json",
  "title": "Thesis",
  "description": "A long-lived, declarative view the agent maintains about one subject (RFC-004). Template-agnostic envelope: subject, tracked_quantities, material_change keys, and template_params are validated against the pinned template in stage two (RFC-009). Every PUT creates a new spec_revision. The fields under 'state' are system-managed and read-only.",
  "type": "object",
  "required": ["id", "template", "subject", "sources", "policy"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$",
      "description": "Owner-chosen slug, unique per tenant."
    },
    "template": { "$ref": "#/$defs/TemplateRef" },
    "subject": {
      "type": "object",
      "description": "Validated against templates/<id>/subject.schema.json (stage two)."
    },
    "tracked_quantities": {
      "type": "object",
      "description": "Per-quantity enablement. Defaults to every template quantity enabled. Required template quantities cannot be disabled; quantities cannot be added. Names are checked against the template manifest.",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]{1,63}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "enabled": { "type": "boolean" } }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "description": "Adapter configs, in priority order. Only source types in the template's sources_allowed are accepted (stage two).",
      "items": { "$ref": "#/$defs/Source" }
    },
    "policy": { "$ref": "#/$defs/Policy" },
    "delivery": {
      "type": "object",
      "description": "Optional. A single webhook fired via the idempotent outbox (RFC-003).",
      "additionalProperties": false,
      "properties": {
        "webhook": {
          "type": "object",
          "required": ["url"],
          "additionalProperties": false,
          "properties": {
            "url": { "type": "string", "format": "uri" },
            "secret_ref": { "type": "string", "description": "Name of the secret used to sign payloads; never the secret itself." },
            "on": {
              "type": "array",
              "items": { "enum": ["version_approved", "thesis_resolved"] },
              "default": ["version_approved"]
            }
          }
        }
      }
    },
    "state": {
      "type": "object",
      "readOnly": true,
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["active", "paused", "resolved", "archived"] },
        "watching": { "type": "boolean" },
        "spec_revision": { "type": "integer", "minimum": 1 },
        "head_version_id": { "type": ["string", "null"], "description": "Latest approved ThesisVersion." },
        "pending_version_id": { "type": ["string", "null"], "description": "Candidate in needs_review, if any." },
        "predecessor_thesis_id": { "type": ["string", "null"], "description": "Set when this thesis was started by another template's on_resolution hand-off (RFC-009 Chaining)." },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    }
  },
  "$defs": {
    "TemplateRef": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,31}$", "description": "A template folder under design/templates/." },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "Source": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["edgar", "press_release", "news", "web_search", "market_data"] },
        "tier": { "enum": ["primary", "secondary"], "description": "Defaults: edgar, press_release, market_data = primary; news, web_search = secondary. news and web_search cannot be raised to primary." }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "edgar" } } },
          "then": {
            "required": ["forms"],
            "properties": {
              "ciks": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]{10}$" }, "description": "Subject CIKs; every filing in 'forms' is routed." },
              "related_ciks": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]{10}$" }, "description": "Other parties' filings, routed only if they mention a subject entity (RFC-005 step 2)." },
              "related_tickers": { "type": "array", "items": { "type": "string" }, "description": "Resolved to CIKs at ingest; same routing rule as related_ciks." },
              "forms": { "type": "array", "minItems": 1, "items": { "type": "string" } }
            },
            "anyOf": [
              { "required": ["ciks"] },
              { "required": ["related_ciks"] },
              { "required": ["related_tickers"] }
            ]
          }
        },
        {
          "if": { "properties": { "type": { "const": "press_release" } } },
          "then": {
            "required": ["issuers"],
            "properties": {
              "issuers": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Subject party keys, or CIKs." },
              "feeds": { "type": "array", "items": { "type": "string", "format": "uri" } }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "news" } } },
          "then": {
            "required": ["outlets"],
            "properties": {
              "outlets": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Configured outlet IDs; each outlet carries a reliability (high | normal) in adapter config." },
              "tier": { "const": "secondary" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "web_search" } } },
          "then": {
            "required": ["queries"],
            "properties": {
              "queries": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "tier": { "const": "secondary" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "market_data" } } },
          "then": {
            "required": ["tickers"],
            "properties": {
              "tickers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "market_proxy": { "type": "string", "description": "Index ticker used by a template's baseline formula, if any." }
            }
          }
        }
      ]
    },
    "Policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "material_change": {
          "type": "object",
          "description": "Overrides of template defaults, keyed by quantity name. Each value uses the core rule shape for that quantity's type (quantity-types.schema.json#/$defs/Rules); the type is checked in stage two.",
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]{1,63}$" },
          "additionalProperties": {
            "anyOf": [
              { "$ref": "quantity-types.schema.json#/$defs/Rules/$defs/probability" },
              { "$ref": "quantity-types.schema.json#/$defs/Rules/$defs/outcome_distribution" },
              { "$ref": "quantity-types.schema.json#/$defs/Rules/$defs/scenario_set" },
              { "$ref": "quantity-types.schema.json#/$defs/Rules/$defs/date_estimate" },
              { "$ref": "quantity-types.schema.json#/$defs/Rules/$defs/list" },
              { "$ref": "quantity-types.schema.json#/$defs/Rules/$defs/facts" }
            ]
          }
        },
        "template_params": {
          "type": "object",
          "description": "Overrides of template parameters; validated against templates/<id>/params.schema.json (stage two)."
        },
        "reestimate_days": { "type": ["integer", "null"], "minimum": 1, "description": "Scheduled re-estimate cadence (RFC-005 step 3). Defaults to the template's value; null only if the template allows none." },
        "budget_usd_per_evaluation": { "type": "number", "exclusiveMinimum": 0 },
        "max_latency_s": { "type": "integer", "minimum": 1 },
        "min_primary_sources": { "type": "integer", "minimum": 0, "default": 1 },
        "debounce_s": { "type": "integer", "minimum": 0, "default": 900 },
        "review": {
          "enum": ["required", "auto"],
          "default": "required",
          "description": "auto is accepted only in replay evaluation (RFC-007). Live theses reject it."
        },
        "routing": {
          "type": "object",
          "description": "Per-role overrides within template constraints. Constraints such as provider_must_differ_from cannot be removed.",
          "propertyNames": { "enum": ["planner", "estimator", "extractor", "auditor"] },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "tier": { "enum": ["strongest", "low_cost"] },
              "provider": { "type": "string" },
              "model_id": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
